# Variables de Entorno del Proyecto AmigoGasto

# Configuración del Backend NestJS
PORT=3001
NODE_ENV=development
API_PREFIX=api

# Configuración de Base de Datos MySQL (Docker Compose)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=amigouser
DB_PASSWORD=amigopassword
DB_NAME=amigogasto_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Configuración del Frontend
VITE_API_URL=http://localhost:3001/api
